# 行尾策略：本仓库源码与文档统一使用 CRLF（Windows 项目）
# 文本文件入库时按 CRLF 保存，检出时也还原为 CRLF，避免跨机器编辑产生整文件 diff
* text=auto eol=crlf

# 明确指定文本类型（避免被误判为二进制）
*.py      text eol=crlf
*.md      text eol=crlf
*.yml     text eol=crlf
*.yaml    text eol=crlf
*.json    text eol=crlf
*.txt     text eol=crlf
*.toml    text eol=crlf
*.cfg     text eol=crlf
*.spec    text eol=crlf
*.gitignore text eol=crlf
*.gitattributes text eol=crlf

# 模板图与打包产物按二进制处理，禁止任何行尾转换
*.png     binary
*.jpg     binary
*.ico     binary
*.exe     binary
