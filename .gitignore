.ruff_cache
.mypy_cache

# ---- 构建与打包产物 ----
build
dist
GUI.exe
Backup

# ---- 运行期配置与产物（不入库）----
# config/ = 静态配置（Setting.yml），用户手改
# state/  = 运行期状态（Last_times.yml / Gui_state.yml / gui.json），程序读写
config
state
# 运行期开关模块（PR7 起叫 runtime.py）
runtime.py
# 旧名字，保留这条以兼容历史文件
config.py
logs
# 旧版本把崩溃日志写在项目根；新版本已改到 logs/app_crash.log。
# 保留这条规则是为了兼容历史文件（老 GUI.exe 仍可能在这里生成）。
app_crash.log
txt.txt

# ---- 调试脚本（不作为交付入口）----
# 本地调试脚本统一放 dev/（见 dev/README.md）；下面两条不带路径，
# 会匹配任意层级的同名文件，因此 dev/test.py、dev/test_main.py 同样被忽略。
test.py
test_main.py

# ---- 本地教学示例（pytest 写法示范，不入库）----
# 内容与 README「怎么写测试（从零开始）」一节重复，属于个人学习用的可运行副本。
# 正式测试套件是 tests/test_task_registry.py 等三个文件，正常入库。
tests/test_示例_*.py

# ---- 会话临时产物收容所（不属于项目，可随时整体删除）----
.dsh-scratch
